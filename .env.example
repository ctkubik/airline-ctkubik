# Optional: copy this file to .env to choose your own login credentials.
#
# If you skip this entirely, the container generates a random password and
# cookie secret on first boot, saves them in the data volume, and prints the
# login details in the container logs:  docker compose logs app

# Username you'll type at http://localhost:3000/login (default: admin)
AUTH_USERNAME=admin

# Password you'll type at http://localhost:3000/login
AUTH_PASSWORD=changeme

# A long random string used to sign login cookies.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string
