# Optional: copy this file to .env to choose your own login credentials.
#
# If you skip this entirely, the container generates a random password and
# cookie secret on first boot, saves them in the data volume, and prints the
# login details in the container logs:  docker compose logs app

# Username you'll type at http://localhost:3000/login (default: admin)
AUTH_USERNAME=admin

# Password you'll type at http://localhost:3000/login
AUTH_PASSWORD=changeme

# A long random string used to sign login cookies.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# ── Fare watches (multi-airline price tracking) ──────────────────────────
# Free API keys from https://developers.amadeus.com (Self-Service).
# Without these, the Fare Watches page still works but no checks run.
#AMADEUS_CLIENT_ID=
#AMADEUS_CLIENT_SECRET=
# "test" (default, free sandbox data) or "production" once you request
# production keys (also free for this usage level).
#AMADEUS_ENV=test
# How often each watch is checked, in hours (default 6)
#FARE_WATCH_INTERVAL_HOURS=6
# The same Amadeus keys also power day-of-travel flight-status checks.
# How often upcoming flights (within 36h) are checked, in minutes (default 60)
#FLIGHT_STATUS_INTERVAL_MINUTES=60
# Better real-time flight status (delays, gate, cancellations) incl. Southwest.
# Free tier via RapidAPI (aerodatabox). If set, it's used instead of Amadeus
# for status. Set a hard request limit in RapidAPI to avoid overage.
#AERODATABOX_API_KEY=

# ── Public URL via Cloudflare Tunnel (optional) ──────────────────────────
# Token from Cloudflare Zero Trust > Networks > Tunnels. Start the tunnel
# with:  docker compose --profile tunnel up -d
#CLOUDFLARE_TUNNEL_TOKEN=
