# Optional: copy this file to .env to choose your own login credentials.
#
# Docker: if you skip this entirely, the container generates a random password
# and cookie secret on first boot, saves them in the data volume, and prints
# the login details in the container logs:  docker compose logs app
#
# macOS (native): ./macos/install.sh creates .env from this file for you and
# fills in a random password and secret. After editing it, run:
#   ./macos/ctl.sh restart

# Username you'll type at http://localhost:3000/login (default: admin)
AUTH_USERNAME=admin

# Password you'll type at http://localhost:3000/login
AUTH_PASSWORD=changeme

# A long random string used to sign login cookies.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# ── Fare watches (multi-airline price tracking) ──────────────────────────
# NOTE: Amadeus shut down its Self-Service API on July 17, 2026 and disabled
# all self-service keys, so fare watches can't check prices until a new fare
# source is added. These settings are kept for Amadeus Enterprise customers.
#AMADEUS_CLIENT_ID=
#AMADEUS_CLIENT_SECRET=
# "test" (default, free sandbox data) or "production" once you request
# production keys (also free for this usage level).
#AMADEUS_ENV=test
# How often each watch is checked, in hours (default 6)
#FARE_WATCH_INTERVAL_HOURS=6
# How often Southwest watches (read from southwest.com in the app's browser)
# are checked, in hours (default 6)
#SOUTHWEST_WATCH_INTERVAL_HOURS=6

# ── Public URL via Cloudflare Tunnel (optional) ──────────────────────────
# Token from Cloudflare Zero Trust > Networks > Tunnels. Start the tunnel
# with:  docker compose --profile tunnel up -d
#CLOUDFLARE_TUNNEL_TOKEN=

# ── Safety net ───────────────────────────────────────────────────────────
# Hours before each check-in to start confirming it will work (default 3)
#CHECKIN_READINESS_HOURS=3
# Optional outside monitor for when the whole machine is down: create a free
# check at https://healthchecks.io (period 5 min, grace 10 min), connect it to
# your phone, and paste its ping URL here. The worker pings it every 5 minutes.
#HEALTHCHECK_PING_URL=

# ── Local AI (optional) ──────────────────────────────────────────────────
# A model running on this machine in LM Studio (or any OpenAI-compatible
# server). Explains errors on the Diagnostics tab, fills in fare watches from
# a sentence, and helps seat-upgrade automation when Southwest changes its
# site. Check-ins never depend on it. See MACOS.md for setup.
#LLM_ENABLED=true
# LM Studio's server address. From inside Docker use
# http://host.docker.internal:1234/v1 instead.
#LLM_BASE_URL=http://localhost:1234/v1
# Model id from LM Studio (e.g. qwen/qwen3-8b). Blank = first loaded model.
#LLM_MODEL=
# Seconds to wait for each answer (default 60)
#LLM_TIMEOUT=60

# ── Advanced (native macOS) ──────────────────────────────────────────────
# Where the database, captures and logs live (default: ./data in this folder)
#DATA_DIR=
# Dashboard port (default 3000) and bind address (default 0.0.0.0 = reachable
# from your network; 127.0.0.1 = this Mac only)
#PORT=3000
#BIND_ADDRESS=0.0.0.0
# Chrome display: headed (default on macOS, a real Chrome window), headless,
# or xvfb (Docker/Linux). Headed is least likely to be blocked by Southwest.
#BROWSER_MODE=headed
